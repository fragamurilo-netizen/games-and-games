# Overdrive static assets.
#
# LiteSpeed compresses and caches these by default, but the theme ships this
# file so the contract survives a server move, a plugin reset or a fallback to
# plain Apache. Every directive is inside an <IfModule>, so a host without the
# module ignores it instead of returning 500.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2?|avif|webp|svg|png|jpe?g|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Text assets must be compressed. The theme's CSS bundle is the largest
# render-blocking resource on the page and compresses roughly 8:1; shipping it
# uncompressed is the difference between a fast first paint and a slow one.
# woff2 is already Brotli-compressed internally and is deliberately excluded —
# recompressing it costs CPU and returns nothing.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Fonts are same-origin here, but a CDN or a staging host can change that.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:woff2?|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
