static var _cache: Dictionary = {}


static func has(name: String) -> bool:
	return PATHS.has(name)


## Polígonos (Array de PackedVector2Array) do símbolo, no quadrado [-1, 1].
static func polys(name: String) -> Array:
	if _cache.has(name):
		return _cache[name]
	var out := _parse(String(PATHS.get(name, "")))
	_cache[name] = out
	return out


static func _parse(d: String) -> Array:
	var out: Array = []
	if d == "":
		return out
	var tok := d.replace(",", " ").split(" ", false)
	var i := 0
	var cur := PackedVector2Array()
	var pos := Vector2.ZERO
	var cmd := ""
	while i < tok.size():
		var t: String = tok[i]
		if t in ["M", "L", "Q", "C", "Z"]:
			cmd = t
			i += 1
			if cmd == "Z":
				if cur.size() >= 3:
					out.append(cur)
				cur = PackedVector2Array()
				continue
		match cmd:
			"M":
				if cur.size() >= 3:
					out.append(cur)
				cur = PackedVector2Array()
				pos = Vector2(float(tok[i]), float(tok[i + 1]))
				cur.append(pos)
				i += 2
				cmd = "L"
			"L":
				pos = Vector2(float(tok[i]), float(tok[i + 1]))
				cur.append(pos)
				i += 2
			"Q":
				var c := Vector2(float(tok[i]), float(tok[i + 1]))
				var e := Vector2(float(tok[i + 2]), float(tok[i + 3]))
				for k in range(1, 7):
					var q := float(k) / 6.0
					cur.append(pos.lerp(c, q).lerp(c.lerp(e, q), q))
				pos = e
				i += 4
			"C":
				var a := Vector2(float(tok[i]), float(tok[i + 1]))
				var b := Vector2(float(tok[i + 2]), float(tok[i + 3]))
				var e2 := Vector2(float(tok[i + 4]), float(tok[i + 5]))
				for k in range(1, 9):
					var q := float(k) / 8.0
					var p1 := pos.lerp(a, q)
					var p2 := a.lerp(b, q)
					var p3 := b.lerp(e2, q)
					cur.append(p1.lerp(p2, q).lerp(p2.lerp(p3, q), q))
				pos = e2
				i += 6
			_:
				i += 1
	if cur.size() >= 3:
		out.append(cur)
	return out
