; Mais Uma Rodada — simulador de gestão de futebol
; Configuração principal do projeto Godot 4.7

config_version=5

[application]

config/name="Mais Uma Rodada"
config/description="Simulador de gestão de futebol. Só mais uma rodada."
config/version="0.2.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
boot_splash/bg_color=Color(0.054902, 0.086275, 0.129412, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/brand/icon_foreground.png"
boot_splash/fullsize=false
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
UIManager="*res://scripts/autoload/ui_manager.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/theme/main_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.054902, 0.086275, 0.129412, 1)
