{"version":1,"source":"tools/build_universe.py — Game Design Bible §§2–3, 13–14","eras":[{"id":"era_vale_tudo","from":1991,"to":1999,"name":"A Era do Vale-Tudo","summary":"Torneios sem categorias, luvas opcionais e estilo contra estilo. O Brasil exporta o jiu-jitsu, o Japão cria os megaeventos e os EUA descobrem o PPV."},{"id":"era_regulation","from":2000,"to":2006,"name":"Regulamentação","summary":"As comissões adotam as regras unificadas, surgem as categorias de peso e os rounds. A Crown nasce das cinzas de um torneio de uma noite e aposta tudo em cinturões."},{"id":"era_tv_boom","from":2007,"to":2014,"name":"O Boom da TV","summary":"Reality shows, TV a cabo e a primeira geração de superestrelas. A Imperial cai, a Shinsei herda o Japão, a Crown engole a Atlantic e a Europa ganha circuitos próprios."},{"id":"era_global","from":2015,"to":2021,"name":"Globalização e Streaming","summary":"Divisões femininas, streaming, fusões e novas potências: Iron Circle, Pacific Fight League e Ascend. A pandemia de 2020 mata promotoras menores."},{"id":"era_rights_crisis","from":2022,"to":2026,"name":"A Crise dos Direitos","summary":"Bolsas sobem, o investidor da Riviera dá calote, os contratos de mídia vencem juntos e dezenas de atletas chegam ao fim de contrato ao mesmo tempo."},{"id":"era_open","from":2027,"to":2027,"name":"The Open Era","summary":"Janeiro de 2027: nenhuma empresa controla o esporte. Mercado aberto, cinturões em disputa e espaço para uma nova promotora."}],"timeline":[{"date":"1991-10-12","kind":"fundacao","title":"Nasce o Vale-Tudo Mundial","text":"Primeiro torneio no Rio reúne 8 lutadores de estilos diferentes, sem categorias de peso.","org":"def_vtm"},{"date":"1993-11-20","kind":"fundacao","title":"Open Combat Invitational em Denver","text":"Um torneio de uma noite em cadeia de TV fechada apresenta o 'vale-tudo' aos EUA.","org":"def_open_combat"},{"date":"1995-03-04","kind":"marco","title":"O primeiro PPV","text":"A OCI vende 86 mil PPVs; os cassinos de Las Vegas prestam atenção.","org":"def_open_combat"},{"date":"1997-07-19","kind":"fundacao","title":"Fundada a Shinsei","text":"Tóquio ganha sua própria promoção em ringue, com rounds e tradição de artes marciais.","org":"org_shinsei"},{"date":"1997-10-11","kind":"fundacao","title":"Imperial Fighting Federation estreia","text":"40 mil pessoas em Saitama para a primeira noite da IFF.","org":"def_imperial"},{"date":"1999-06-01","kind":"fim","title":"Fim do Vale-Tudo Mundial","text":"Sem TV e sem licenças, o VTM encerra atividades.","org":"def_vtm"},{"date":"2000-04-02","kind":"regras","title":"Regras unificadas","text":"Comissões dos EUA adotam categorias de peso, rounds de 5 minutos e o critério 10-9.","org":null},{"date":"2000-09-15","kind":"fundacao","title":"Nasce a Crown Combat","text":"Um grupo de cassinos compra a OCI e relança a marca como Crown Combat, com cinturões por categoria.","org":"org_crown"},{"date":"2001-03-10","kind":"fundacao","title":"Vale Combat em São Paulo","text":"Empresários paulistas criam a Vale Combat para manter os talentos brasileiros em casa.","org":"org_vale"},{"date":"2003-05-24","kind":"fundacao","title":"Atlantic Fight League","text":"Atlantic City ganha uma rival direta da Crown.","org":"def_atlantic"},{"date":"2005-04-09","kind":"marco","title":"Caminho da Coroa","text":"O reality show da Crown estreia na TV a cabo e cria a primeira geração de fãs casuais.","org":"org_crown"},{"date":"2006-02-18","kind":"fundacao","title":"Frontline em Londres","text":"Primeira promoção europeia com produção de nível global.","org":"org_frontline"},{"date":"2007-12-31","kind":"marco","title":"O Réveillon de Saitama","text":"A última grande noite da Imperial reúne 48 mil pessoas e o maior público de MMA da história até então.","org":"def_imperial"},{"date":"2008-05-20","kind":"fim","title":"Queda da Imperial","text":"Escândalo de patrocinadores derruba a IFF. A Shinsei contrata metade do elenco.","org":"def_imperial"},{"date":"2010-03-01","kind":"regras","title":"TV alemã bane o MMA","text":"Emissoras públicas alemãs retiram lutas da grade; o mercado alemão encolhe por quatro anos.","org":null},{"date":"2011-01-15","kind":"fundacao","title":"Iron Circle em Almaty","text":"Capital cazaque e treinadores soviéticos fundam a Iron Circle, focada em grappling.","org":"org_iron"},{"date":"2011-06-30","kind":"fusao","title":"Crown compra a Atlantic","text":"A maior aquisição da década: cinco campeões e a biblioteca de lutas da AFL passam para a Crown.","org":"org_crown"},{"date":"2012-04-21","kind":"fundacao","title":"Pacific Fight League","text":"Sydney vira sede da primeira liga profissional do Pacífico.","org":"org_pfl"},{"date":"2013-02-23","kind":"marco","title":"Primeira luta feminina valendo cinturão global","text":"A Crown cria o Galo feminino e lota a arena.","org":"org_crown"},{"date":"2013-09-01","kind":"fim","title":"Neon Nights fecha","text":"A promotora que tentou superar a Crown com bolsas milionárias declara falência.","org":"def_neon"},{"date":"2014-08-08","kind":"fundacao","title":"Ascend Fighting","text":"Dinheiro de streaming funda a Ascend em Los Angeles, com calendário de volume.","org":"org_ascend"},{"date":"2014-10-01","kind":"regras","title":"Alemanha libera a TV de novo","text":"Fim do banimento televisivo; circuitos alemães voltam.","org":null},{"date":"2016-04-14","kind":"regras","title":"Nova York legaliza o MMA profissional","text":"Fim de uma batalha legislativa de 20 anos.","org":null},{"date":"2016-07-01","kind":"fusao","title":"Vale absorve a Samba Cage","text":"A Vale vira a potência absoluta da América do Sul.","org":"org_vale"},{"date":"2016-11-10","kind":"fusao","title":"PFL incorpora a Pacific Rim","text":"Singapura e Sydney sob a mesma bandeira.","org":"org_pfl"},{"date":"2019-03-20","kind":"fusao","title":"Iron Circle absorve a Eurasia","text":"Biblioteca e elenco russos passam para Almaty.","org":"org_iron"},{"date":"2020-01-24","kind":"regras","title":"França libera o MMA","text