[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = false

[libraries]
linux.debug.x86_64     = "bin/x86_64-unknown-linux-gnu/libgodot_wry.so"
linux.release.x86_64   = "bin/x86_64-unknown-linux-gnu/libgodot_wry.so"
windows.debug.x86_64   = "bin/x86_64-pc-windows-gnu/godot_wry.dll"
windows.release.x86_64 = "bin/x86_64-pc-windows-gnu/godot_wry.dll"

[icons]
WebView = "icons/webview.svg"

[dependencies]
windows.debug.x86_64 = { "bin/x86_64-pc-windows-gnu/godot_wry.dll" : "", "bin/x86_64-pc-windows-gnu/WebView2Loader.dll" : "" }
windows.release.x86_64 = { "bin/x86_64-pc-windows-gnu/godot_wry.dll" : "", "bin/x86_64-pc-windows-gnu/WebView2Loader.dll" : "" }
linux.debug.x86_64 = { "bin/x86_64-unknown-linux-gnu/libgodot_wry.so": "" }
linux.release.x86_64 = { "bin/x86_64-unknown-linux-gnu/libgodot_wry.so": "" }
